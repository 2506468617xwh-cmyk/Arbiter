# RAbot environment variables

# DeepSeek API key
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# RAbot LLM model
# Recommended:
# deepseek-v4-flash: faster and cheaper for reports
# deepseek-v4-pro: stronger reasoning, slower and more expensive
RABOT_LLM_MODEL=deepseek-v4-flash

# Optional: enable thinking mode for DeepSeek V4 models
# enabled / disabled
RABOT_LLM_THINKING=disabled

# Tushare token
TUSHARE_TOKEN=your_tushare_token_here